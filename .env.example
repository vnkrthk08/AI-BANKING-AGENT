# ---- Runtime ----------------------------------------------------------------------
APP_ENV=development                 # development | test | production (production fails closed on unsafe config)
KURAL_MASTER_KEY=                   # REQUIRED in production: >=32 random chars (JWT signing + envelope keys)
KURAL_PUBLIC_BASE_URL=              # https://ops.yourbank.in — used for telephony status callbacks
KURAL_CORS_ORIGINS=                 # only if the UI is served from a different origin
KURAL_RUN_WORKERS=                  # default true in development; run `python -m kural.workers` separately in production
KURAL_AUTO_MIGRATE=                 # default true outside production; production runs `alembic upgrade head` as a release step

# ---- Database ---------------------------------------------------------------------
POSTGRES_DB=kural
POSTGRES_USER=kural
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://kural:change-this-local-password@127.0.0.1:5432/kural   # sqlite:///./kural_local.db for local dev only

# ---- Language understanding (optional; KURAL falls back to deterministic rules) -------
LLM_PROVIDER=gemini                 # gemini | groq | openrouter
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ---- Speech (required for live voice) -------------------------------------------------
SARVAM_API_KEY=
STT_PROVIDER=sarvam                 # 'local' is a TEST-ONLY simulator and is refused at runtime

# ---- Calling policy -------------------------------------------------------------------
KURAL_CALLING_WINDOW_START_HOUR=9
KURAL_CALLING_WINDOW_END_HOUR=19
KURAL_HOLIDAYS=                     # 2026-10-20,2026-11-08
KURAL_CALL_RECORDING_ENABLED=false  # enable only with an approved recording disclosure + retention policy
KURAL_RECORDING_RETENTION_DAYS=90

# ---- Telephony ------------------------------------------------------------------------
TELEPHONY_PROVIDER=disabled         # disabled | exotel | sandbox (sandbox = simulator, refused in production)
TELEPHONY_WEBHOOK_TOKEN=            # shared secret appended to status-callback URLs
TELEPHONY_DIAL_ALLOWLIST=           # comma-separated test numbers; REQUIRED outside production or nothing is dialled
KURAL_OUTBOUND_AUTODIAL_ENABLED=false   # due callbacks auto-dial only when true (otherwise handed to a human)
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
EXOTEL_APP_ID=                      # Exotel flow that connects the call to the AVA voice bot

# ---- Notifications --------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_SENDER_ID=
SMS_DLT_TEMPLATE_ID=
KURAL_CUSTOMER_SMS_ENABLED=false
