te;color:#778497;font-size:10px}.ops-detail-tabbar button.active{background:#eaf4f3;color:#14787a;font-weight:700}.ops-detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:13px}.ops-detail-panel{border:1px solid var(--line);border-radius:7px;overflow:hidden}.ops-detail-panel h3{margin:0;padding:10px 12px;border-bottom:1px solid #edf0f3;font:700 11px Manrope}.ops-detail-panel h3 span{float:right;color:#9ba5b1;font:700 8px 'DM Sans'}.ops-audio-wave{height:70px;display:flex;align-items:center;justify-content:center;gap:3px;padding:0 12px;background:#f6f8f9}.ops-audio-wave i{width:3px;border-radius:3px;background:#80aaa8}.ops-json{padding:12px;overflow:auto;background:#f7f9fa;font-size:9px;color:#627087}.ops-decision-timeline{list-style:none;padding:10px 14px}.ops-decision-timeline li{display:flex;gap:10px;padding:7px 0}.ops-decision-timeline li>i{width:8px;height:8px;border-radius:50%;background:#1a8a80;margin-top:3px}.ops-decision-timeline li span{display:grid;gap:4px}.ops-decision-timeline strong{font-size:9px}.ops-decision-timeline small{font-size:8px;color:#8995a3}.ops-consent-row,.ops-audit-row{display:flex;align-items:center;gap:9px;padding:12px;color:#378164}.ops-consent-row>div,.ops-audit-row>span{display:grid;gap:4px;flex:1}.ops-consent-row strong,.ops-audit-row strong{font-size:10px;color:#4b5b70}.ops-consent-row span,.ops-audit-row small{font-size:8px;color:#8995a3}.ops-notice-banner+.ops-callback-summary{margin-top:9px}.ops-kpi-card:hover,.ops-panel:hover{border-color:#d4dde4}.ops-kpi-delta.down{color:#b6474b}.ops-positive-value{color:#378261}.ops-negative-value{color:#ad484b}.ops-unassigned{color:#a57a38}.ops-button-row{display:flex;gap:6px;flex-wrap:wrap;margin-top:9px}.ops-agent-capacity{display:grid;grid-template-columns:repeat(3,1fr);padding:12px 8px;border-bottom:1px solid #edf0f3}.ops-agent-capacity>div{display:grid;text-align:center;gap:4px}.ops-agent-capacity strong{font:700 19px Manrope}.ops-agent-capacity span{font-size:8px;color:#8290a0}.ops-agent-list{padding:5px 11px}.ops-agent-row{display:flex;align-items:center;gap:8px;padding:8px 0;border-bottom:1px solid #f0f2f4}.ops-person-avatar{display:grid;place-items:center;width:25px;height:25px;border-radius:50%;background:#e8eef3;color:#637a93;font-size:8px;font-weight:700}.ops-agent-row>span:nth-child(2){display:grid;gap:3px;flex:1}.ops-agent-row strong{font-size:9px}.ops-agent-row small{font-size:8px;color:#8995a3}.ops-live-call-grid,.ops-live-card-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;padding:11px}.ops-live-call-card,.ops-live-detail-card{padding:11px;border:1px solid var(--line);border-radius:7px;display:grid;gap:7px}.ops-live-call-top,.ops-live-card-head{display:flex;justify-content:space-between;align-items:center}.ops-live-call-top>span:last-child,.ops-live-card-head time{font-size:8px;color:#97a2ae}.ops-live-call-card>strong,.ops-live-detail-card>strong{font-size:10px}.ops-live-call-card>strong small,.ops-live-detail-card>span{font-size:8px;color:#8793a2;font-weight:400}.ops-live-call-card>span,.ops-live-state-line{font-size:8px;color:#7b8998}.ops-live-call-state{font-size:8px;color:#4d6475}.ops-live-sentiment{display:flex;align-items:center;gap:6px;color:#8793a0;font-size:8px}.ops-live-sentiment strong{color:#3c805f}.ops-dark,.ops-app:has(html[data-theme=dark]){color-scheme:dark}
html[data-theme=dark] body{background:#111925}html[data-theme=dark] .ops-app{--canvas:#121c29;--surface:#1b2838;--surface-2:#202e3f;--ink:#e1e7ee;--muted:#9aa8b8;--line:#304052;--shadow:none;color:#e1e7ee}html[data-theme=dark] .ops-topbar,html[data-theme=dark] .ops-panel,html[data-theme=dark] .ops-kpi-card,html[data-theme=dark] .ops-agent-score,html[data-theme=dark] .ops-callback-summary,html[data-theme=dark] .ops-customer-banner,html[data-theme=dark] .ops-health-banner{background:var(--surface)}html[data-theme=dark] .ops-page-heading h1,html[data-theme=dark] .ops-panel-head h2,html[data-theme=dark] .ops-kpi-value strong,html[data-theme=dark] .ops-campaign-row strong,html[data-theme=dark] .ops-agent-score strong{color:#e1e8ef}html[data-theme=dark] .ops-breadcrumb strong,html[data-theme=dark] .ops-role-select select{color:#e1e8ef}html[data-theme=dark] .ops-demo-banner{background:#1b3137;color:#99c7c6;border-color:#30484d}html[data-theme=dark] .ops-table td{color:#bdc8d4;border-color:#2b3948}html[data-theme=dark] .ops-table th{background:#202d3c;color:#a8b5c4}html[data-theme=dark] .ops-table tbody tr:hover,html[data-theme=dark] .ops-queue-item:hover{background:#213341}html[data-theme=dark] .ops-queue-item,html[data-theme=dark] .ops-campaign-row,html[data-theme=dark] .ops-case-card{background:#1b2838;color:#d8e0e9;border-color:#304052}html[data-theme=dark] .ops-campaign-row.active,html[data-theme=dark] .ops-queue-item.active{background:#1d373a}html[data-theme=dark] .ops-agent-next,html[data-theme=dark] .ops-test-console{background:#1b2838}html[data-theme=dark] .ops-fact-list strong,html[data-theme=dark] .ops-transcript p{color:#c1ccd7}html[data-theme=dark] .ops-summary-panel,html[data-theme=dark] .ops-ai-summary{background:#1b3539;border-color:#315053}html[data-theme=dark] .ops-button-secondary,html[data-theme=dark] .ops-filterbar label,html[data-theme=dark] .ops-search-trigger,html[data-theme=dark] .ops-column-picker summary{background:#202f40;color:#c5d0dc;border-color:#37485a}html[data-theme=dark] .ops-search-dialog,html[data-theme=dark] .ops-search-results button,html[data-theme=dark] .ops-export-menu>div{background:#1b2838;color:#d8e0e9}html[data-theme=dark] .ops-footer{border-color:#304052}html[data-theme=dark] .ops-health-stat strong{color:#dae3ec}html[data-theme=dark] .ops-resolution-form input,html[data-theme=dark] .ops-resolution-form textarea,html[data-theme=dark] .ops-resolution-form select,html[data-theme=dark] .ops-schedule-form input,html[data-theme=dark] .ops-journey-select select{background:#202f40;color:#e0e6ed;border-color:#3a4a5d}
@media(max-width:1200px){.ops-kpi-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.ops-callback-row{grid-template-columns:90px 120px minmax(120px,1fr) 120px}.ops-callback-actions{grid-column:2/-1}.ops-live-call-grid,.ops-live-card-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.ops-topbar{padding:0 18px}.ops-content{padding:20px 18px}.ops-demo-banner,.ops-filterbar{padding-left:18px;padding-right:18px}}
@media(max-width:850px){.ops-sidebar{width:65px}.ops-main{margin-left:65px}.ops-brand{padding-left:16px}.ops-brand-copy,.ops-workspace-switch>span:not(:first-child),.ops-workspace-switch>svg,.ops-nav-group-title,.ops-nav-label,.ops-nav-count,.ops-live-status span,.ops-collapse{display:none}.ops-workspace-switch{justify-content:center;padding:8px 5px}.ops-nav-link{justify-content:center;padding:0}.ops-topbar-tools{gap:6px}.ops-search-trigger span,.ops-search-trigger kbd,.ops-clock{display:none}.ops-role-select select{max-width:90px}.ops-grid-2-1,.ops-grid-equal,.ops-grid-1-1,.ops-insight-grid,.ops-compliance-grid,.ops-health-grid,.ops-report-grid,.ops-campaign-layout{grid-template-columns:1fr}.ops-report-grid>.ops-panel:last-child{grid-column:auto}.ops-kpi-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.ops-agent-layout{grid-template-columns:1fr}.ops-agent-queue{position:static;max-height:380px}.ops-agent-detail-grid{grid-template-columns:1fr}.ops-compliance-kpis{grid-template-columns:repeat(2,1fr)}.ops-resolution-form{grid-template-columns:1fr 1fr}.ops-resolution-form textarea{grid-column:1/-1}.ops-live-strip{flex-wrap:wrap;gap:10px}.ops-strip-context{margin-left:0!important}.ops-customer-banner{flex-wrap:wrap}.ops-customer-privacy{margin-left:0}.ops-journey-select{margin-left:auto}.ops-callback-row{grid-template-columns:1fr 1fr}.ops-callback-actions{grid-column:1/-1}.ops-detail-grid{grid-template-columns:1fr}}
@media(max-width:540px){.ops-content{padding:15px 11px}.ops-topbar{height:56px;padding:0 10px}.ops-breadcrumb span:first-child,.ops-breadcrumb span:nth-child(2){display:none}.ops-topbar-tools{gap:2px}.ops-user-avatar{display:none}.ops-role-select span{display:none}.ops-role-select select{max-width:80px;font-size:9px}.ops-page-heading{align-items:flex-start;flex-direction:column}.ops-page-heading h1{font-size:22px}.ops-heading-actions{align-self:flex-start}.ops-filterbar{padding:0 10px 10px;overflow:auto}.ops-filterbar label{flex-shrink:0}.ops-demo-banner{padding:0 10px;font-size:8px}.ops-kpi-grid{gap:7px}.ops-kpi-card{padding:10px}.ops-kpi-value strong{font-size:18px}.ops-live-strip>span{font-size:8px}.ops-agent-score{grid-template-columns:repeat(3,1fr)}.ops-agent-score-note{grid-column:1/-1;border-top:1px solid var(--line)!important;padding:9px 12px!important}.ops-resolution-form{grid-template-columns:1fr}.ops-resolution-form textarea,.ops-resolution-actions{grid-column:auto}.ops-callback-summary{flex-wrap:wrap}.ops-callback-summary>div{padding:9px}.ops-callback-summary p{width:100%;margin:0;padding:8px}.ops-report-export{flex-wrap:wrap}.ops-export-group{width:100%}.ops-customer-banner-stat{padding:0 7px}.ops-detail-meta{flex-wrap:wrap}.ops-detail-summary{grid-template-columns:1fr 1fr;gap:10px}.ops-live-call-grid,.ops-live-card-grid{grid-template-columns:1fr}.ops-kanban{grid-template-columns:repeat(4,230px)}.ops-footer{padding:0 10px;font-size:8px}.ops-footer span:last-child{display:none}}
.ops-filter-bar{min-height:48px;display:flex;align-items:center;gap:11px;padding:6px 30px;background:var(--surface);border-bottom:1px solid var(--line)}.ops-filter-label{display:flex;align-items:center;gap:6px;color:#7c8998;font-size:9px;font-weight:800;letter-spacing:.08em;margin-right:2px}.ops-filter-bar label{display:flex;align-items:center;gap:6px;padding:0 8px;height:30px;border:1px solid var(--line);background:var(--surface-2);border-radius:5px}.ops-filter-bar label>span{font-size:9px;color:#8994a2}.ops-filter-bar select{max-width:150px;border:0;outline:0;background:transparent;color:#46566d;font-size:10px}.ops-filter-time{margin-left:auto;color:#8d98a5;font-size:9px;white-space:nowrap}.ops-reset-button{display:flex;align-items:center;gap:3px;background:none;border:0;color:var(--teal);font-size:9px}.ops-filter-skeleton{height:48px;background:white}.ops-drawer-layer{position:fixed;inset:0;background:#1020346b;z-index:50;display:flex;justify-content:flex-end}.ops-drawer{width:min(590px,94vw);height:100%;background:var(--surface);box-shadow:-12px 0 40px #14223822;display:flex;flex-direction:column;overflow:hidden}.ops-drawer-wide{width:min(980px,95vw)}.ops-drawer-head{height:62px;padding:0 17px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line)}.ops-drawer-head small{font-size:8px;color:#118084;font-weight:800;letter-spacing:.09em}.ops-drawer-head h2{margin:2px 0 0;font:700 16px Manrope}.ops-drawer-body{overflow:auto;flex:1}.ops-test-console .workspace{width:min(1380px,calc(100% - 5vw))}.ops-test-console .welcome-row{min-height:120px}
@media(max-width:850px){.ops-filter-bar{padding:6px 18px;gap:6px;overflow:auto}.ops-filter-time{display:none}.ops-filter-bar label{flex-shrink:0}}
@media(max-width:540px){.ops-filter-bar{padding:5px 10px}.ops-filter-bar label{padding:0 5px;gap:3px}.ops-filter-bar label>span{display:none}.ops-filter-bar select{max-width:110px}}
.ops-resolution-compare{display:grid;grid-template-columns:1fr 1fr;gap:14px;padding:14px}.ops-resolution-compare>div{display:grid;gap:5px}.ops-resolution-compare span{font-size:10px;color:#788699}.ops-resolution-compare strong{font:700 20px Manrope}.ops-resolution-compare small{font-size:8px;color:#919daa}.ops-workload-table{padding:8px 12px}.ops-workload-row{display:grid;grid-template-columns:1.3fr 1fr .5fr .6fr .6fr;gap:6px;align-items:center;padding:8px 0;border-bottom:1px solid #edf0f3;color:#617086;font-size:8px}.ops-workload-row strong{font-size:9px;color:#4b5b70}.ops-workload-head{color:#8c98a5;font-weight:800;font-size:7px;text-transform:uppercase;letter-spacing:.04em}
.ops-inline-create{display:flex;align-items:end;gap:9px;padding:12px;background:#fff;border:1px solid var(--line);border-radius:7px;margin:0 0 12px}.ops-inline-create label{display:grid;gap:5px;font-size:9px;color:#738094}.ops-inline-create input{min-width:230px;padding:8px;border:1px solid var(--line);border-radius:5px}.ops-inline-create>span{margin-right:auto;color:#8a96a4;font-size:9px}
@media(max-width:540px){.ops-inline-create{align-items:stretch;flex-direction:column}.ops-inline-create input{min-width:0}}
.ops-agent-layout{grid-template-columns:1fr}.ops-agent-queue{position:static;max-height:310px}.ops-agent-tabs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));padding:7px;gap:4px}.ops-agent-tabs button[role=tab]{text-align:center;padding:8px 4px;font-size:9px}.ops-queue-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));max-height:196px;overflow:auto}.ops-agent-case{grid-template-columns:repeat(3,minmax(0,1fr))}.ops-agent-next{grid-column:1/-1}.ops-agent-detail-grid{display:contents}.ops-agent-context,.ops-agent-conversation,.ops-resolution{grid-column:auto}.ops-resolution-form{grid-template-columns:1fr}.ops-resolution-actions{grid-column:auto}.ops-agent-context .ops-fact-list>span{align-items:flex-start}.ops-agent-context .ops-fact-list strong{max-width:58%}
@media(max-width:1050px){.ops-agent-case{grid-template-columns:repeat(2,minmax(0,1fr))}.ops-agent-next{grid-column:1/-1}.ops-resolution{grid-column:1/-1}}
@media(max-width:850px){.ops-agent-case{grid-template-columns:1fr}.ops-agent-next,.ops-resolution{grid-column:auto}.ops-agent-tabs{grid-template-columns:repeat(2,minmax(0,1fr))}}

